# ==============================================================================
# CONFIGURACIÓN DE SUPABASE - IMPERIO BARBER
# ==============================================================================
# Obtén estos valores en tu panel de Supabase:
# 1. Ve a https://app.supabase.com y abre tu proyecto.
# 2. Haz clic en "Project Settings" (ícono de engranaje) -> "API".
# 3. Copia la "Project URL" y pégala en NEXT_PUBLIC_SUPABASE_URL.
# 4. Copia la clave "anon public" y pégala en NEXT_PUBLIC_SUPABASE_ANON_KEY.
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
